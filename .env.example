# Firebase web app configuration (public client keys — safe for the browser;
# access control is enforced by Firestore/Storage security rules).
# When these are unset the app runs in local demo mode with sample data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
