# The Firebase web config is baked into the app (src/services/firebase.ts),
# so the app connects to Firebase out of the box with no env vars needed.
#
# Optional overrides — set these only to point a build at a DIFFERENT
# Firebase project than the baked-in default:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_APP_ID=
#
# Set this to run against the local demo dataset instead of live Firebase
# (useful for demos and UI testing without touching real data):
# VITE_DEMO_MODE=true
